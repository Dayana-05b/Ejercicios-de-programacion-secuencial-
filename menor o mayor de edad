Algoritmo edad 
	// realizar un programa que capture la edad de una persona y determine si es mayor o menor de edad //
	escribir "programa que determina  la mayoria de edad de una persona "
	escribir "buenas"
	escribir "digite su nombre "
	leer nombre
	escribir "digite su edadm"
	leer edadm
	si edadm >= 18 entonces
		escribir nombre," es mayor de edad "
	SiNo
		escribir nombre,"es menor de edad "
	FinSi
	
FinAlgoritmo
