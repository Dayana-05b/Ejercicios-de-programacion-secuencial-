//Proceso para saber la calificacion final
ALGORITMO saber_la_calificacion_final
ESCRIBIR "digite la primera calificacion parcial"
LEER n
ESCRIBIR "digite la segunda calificacion parcial"
LEER r 
ESCRIBIR "digite la tercera calificacion parcial"
LEER l
parciales= ((n+r+l)/3)*0.55
ESCRIBIR  "el 50% de la calificacion es de " ,parciales
ESCRIBIR "digite la calificacion del examen final"
LEER w
examen= (w*30)/100
ESCRIBIR "el 30% de la calificacion es de ", examen
ESCRIBIR "digite la calificacion del trabajo final"
LEER u
trabajo = (u*15)/100
ESCRIBIR "el 15% de la calificacion es de ", trabajo
calificacion_final= parciales+examen+trabajo
ESCRIBIR "la calificacion final es " , calificacion_final
